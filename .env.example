# Local Go process (docker compose overrides DB_DSN for its app container).
APP_PORT=8080
DB_DSN=postgres://finote:finote@localhost:7432/finote?sslmode=disable

# Empty token disables the bot. Obtain a token from Telegram @BotFather.
# Run only one polling instance per token, without an active webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEZONE=Asia/Almaty

# Provider must implement POST /chat/completions and JSON response_format.
# Base URL must include the provider's API prefix, e.g. https://host/v1.
# User messages are sent to this provider for parsing; database records are not.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Add these values to your existing .env; do not overwrite its DB settings.
# Start: docker compose up --build
# Or start only postgres, then: go run ./cmd
# Bot supports private text messages; audio and groups are not processed.
# Examples: кофе 350; такси 1200 вчера; покажи траты за неделю;
# сколько потратил на еду в этом месяце; последнее было не 350, а 450;
# удали такси; удали трату <ID>.
# Ambiguous edits/deletions return IDs: repeat the complete request with an ID.
# Lists show up to 10 entries; sum uses all matching entries.
# Receipts prevent repeated mutations after redelivery/restart. A crash after
# committing an expense but before sending its reply may lose that reply.
# The admin HTTP API has no authentication: do not expose it publicly.
